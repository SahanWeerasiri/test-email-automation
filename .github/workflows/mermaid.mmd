flowchart TD
    A([Workflow triggered]):::gray
    A1[Manual]:::note
    A2[Every day]:::note

    subgraph GH ["☁️  GitHub Actions"]
        B[Ensure label exists<br/>Create or update 'Need Attention']:::purple
        C[Fetch ALL open issues via pagination<br/>Reporter/External — exclude already-labelled]:::purple
        D{Any issues?}:::gray
        EXIT1([Exit]):::gray

        E[For each issue]:::gray

        FC[Fetch ALL comments via pagination]:::teal

        KW{Keyword comment<br/>exists?}:::gray
        REFKW[Use keyword comment date<br/>as reference]:::teal
        REFCA[Use issue createdAt<br/>as reference]:::teal

        ST{Reference date<br/>> threshold?}:::gray
        L1[Apply 'Need Attention' label]:::red
        SKIP[Skip]:::gray

        NEXT{More issues?}:::gray
        DONE([Done]):::gray
    end

    A1 & A2 --> A
    A --> B --> C --> D
    D -- No --> EXIT1
    D -- Yes --> E

    E --> FC --> KW
    KW -- Yes --> REFKW --> ST
    KW -- No --> REFCA --> ST

    ST -- Yes --> L1
    ST -- No --> SKIP

    L1 & SKIP --> NEXT
    NEXT -- Yes --> E
    NEXT -- No --> DONE

    classDef gray   fill:#D3D1C7,stroke:#5F5E5A,color:#2C2C2A
    classDef purple fill:#CECBF6,stroke:#534AB7,color:#26215C
    classDef teal   fill:#9FE1CB,stroke:#0F6E56,color:#04342C
    classDef red    fill:#F7C1C1,stroke:#A32D2D,color:#501313
    classDef amber  fill:#FAC775,stroke:#854F0B,color:#412402
    classDef note   fill:none,stroke:none,color:#888780,font-size:11px